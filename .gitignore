# ==========================================
# Optimized .gitignore for Python & COLMAP Research
# ==========================================

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# --- Environment & Packaging ---
.venv/
venv/
ENV/
env/
.conda/
build/
dist/
*.egg-info/
.eggs/

# --- C/C++ Executables & Binaries ---
*.exe
*.dll
*.so
*.dylib
*.lib
*.a
*.pdb
*.obj
*.o

# --- IDE & OS Files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# --- COLMAP Binaries & Installation ---
colmap/*
!colmap/.gitkeep
colmap-x64-*/

# --- Databases & SQLite Binary Files (> 100MB) ---
*.db
*.db-journal
*.sqlite

# --- Raw Benchmark Datasets & Intermediate Image Copies (> 60GB) ---
datasets/**/images/
datasets/graham-hall/Part2/
datasets/graham-hall/Part3/
datasets/graham-hall/Part4/
datasets/graham-hall/Part5/
datasets/graham-hall/Part6/
datasets/person-hall/Part2/
experiments/**/images/

# --- Large 2D Keypoint & Binary Model Files (> 50MB / GitHub 100MB Limit) ---
*.bin
**/sparse/**/images.txt
*.ply
*.off
*.stl
*.nvm
*.bundler

# --- Large Results, Logs & Archives ---
results/*
!results/.gitkeep
*.log
*.zip
*.tar
*.gz
*.7z
*.z01
*.z02
*.rar
